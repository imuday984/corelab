# Select PostgreSQL for the conventional local Express/Vite deployment; unset this variable for SQLite preview.
DATABASE_URL=postgresql://neondb_owner:npg_hTBX9RwbGPc0@ep-proud-moon-aoskckgo-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:npg_hTBX9RwbGPc0@ep-proud-moon-aoskckgo.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Supply development-only PostgreSQL credentials to docker compose; use private credentials outside local development.
POSTGRES_USER=corelab
# Match the password used in the development DATABASE_URL above.
POSTGRES_PASSWORD=corelab_dev_password
# Name the local application database created by the PostgreSQL image.
POSTGRES_DB=corelab
# Configure the standalone Express listener; Vite prints its own development address.
PORT=3000
# Set development locally; production disables development password-reset URLs.
NODE_ENV=development
# Choose the browser-facing origin used when constructing password-reset links.
APP_ORIGIN=http://localhost:5173
# Optionally override the browser-preview SQLite file when DATABASE_URL is unset.
SQLITE_PATH=work/development.sqlite
# Configure this server-only secret to enable real reset emails; leave blank for local development reset URLs.
RESEND_API_KEY=
# Replace this with a verified Resend sender before enabling real password-reset delivery.
RESET_FROM_EMAIL="CoreLab <onboarding@resend.dev>"
